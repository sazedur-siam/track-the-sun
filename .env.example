# Copy to .env.local and fill in. .env.local is gitignored.
#
# Optional Google Maps Platform API key with the "Routes API" enabled.
# When set, Google becomes the default route provider (live-traffic timing).
# Users can still switch to OSRM or paste a replacement key in Settings.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: public URL of the hosted web build (e.g. https://trackthesun.example.com).
# Shared result links use it, so they open in a browser for people without the app.
# Without it, the app shares a trackthesun:// deep link (web shares its own origin).
EXPO_PUBLIC_WEB_URL=
